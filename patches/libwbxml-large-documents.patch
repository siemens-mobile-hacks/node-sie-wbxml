+/**
+ * @brief Parse a node and all its next siblings (iteratively, to avoid deep recursion)
+ */
+static WBXMLError parse_node(WBXMLEncoder *encoder, WBXMLTreeNode *node, WB_BOOL enc_end)
+{
+    WBXMLError ret = WBXML_OK;
+
+    while (node != NULL) {
+        if ((ret = parse_node_self(encoder, node, enc_end)) != WBXML_OK)
+            return ret;
+        node = node->next;
+        enc_end = TRUE;
+    }
+
+    return WBXML_OK;
 }
 
 
